# ~/.gitconfig - Linux (managed by 2-setup/linux/restore.sh)

[user]
	name = Abdelrahman Zaki
	email = abdelrhmanuzaki@gmail.com

[init]
	defaultBranch = main

# never auto-discover bare repositories (git >= 2.38)
[safe]
	bareRepository = explicit

# Git LFS (install git-lfs to use LFS repositories)
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
