#!/bin/sh
# river-classic init — zaki (Ubuntu 26.04, Oct 2026)
# Deviced after /home/zaki/dwm-setup - after fix (dwm 6.5 muscle memory).
# Everything is runtime-configurable: edit & rerun — no recompiling needed.

# GDM does NOT source ~/.profile — make our ~/.local/bin tools visible!
export PATH="$HOME/.local/bin:$PATH"

# Find the actual compositor. river launches init through a short-lived
# `sh -c` helper, so $PPID is normally that shell (and it can already be a
# zombie), not river. Walk up one level when needed, verify the process name,
# and fall back to the newest `river` process. The gesture daemon, the kanata
# watcher and the cross-session cleanup all depend on this being correct.
resolve_river_pid() {
    pid=$PPID
    if [ -r "/proc/$pid/comm" ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null)" != "river" ]; then
        parent=$(awk '/^PPid:/ { print $2 }' "/proc/$pid/status" 2>/dev/null)
        [ -n "$parent" ] && [ "$parent" -gt 1 ] && pid=$parent
    fi
    if [ -r "/proc/$pid/comm" ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = "river" ]; then
        printf '%s\n' "$pid"
        return 0
    fi
    pgrep -n -x river 2>/dev/null || true
}

river_alive() {
    [ -n "${RIVER_PID:-}" ] || return 1
    [ -r "/proc/$RIVER_PID/stat" ] || return 1
    state=$(awk '{ print $3 }' "/proc/$RIVER_PID/stat" 2>/dev/null)
    [ "$state" != "Z" ] && [ "$state" != "X" ]
}

RIVER_PID=$(resolve_river_pid)
if [ -z "$RIVER_PID" ]; then
    echo "river-classic: could not resolve river PID; parent watchers disabled" >&2
fi

# publish session env to dbus + user systemd, so dbus-activated services (portals!)
# don't die of activation timeouts under non-GNOME compositors (GNOME does this for
# you; river-classic doesn't!)
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null

# A fast river logout leaves the user-manager's portal chain half-dead:
# xdg-desktop-portal-gtk can be restarted by dbus *while* river is already
# exiting (`cannot open display:`); the unit ends up in a `failed` state and
# codeporter dbus activation then refuses it, so the *next* river session's
# first portal call (waybar's Settings) times out at 25 s and river shows
# nothing but the background + cursor. Restart the chain now that the fresh
# env is published; idempotent, and session-cleanup.sh still stops the units
# on river exit so GNOME never inherits river's portal choice. (Found live on
# the Oct 23 relogin: river started with no bar; journal showed only
# `Starting xdg-desktop-portal.service` and waybar's 25 s StartServiceByName
# timeouts, while the *working* session had the same call with -gtk activated
# right behind it.)
if command -v systemctl >/dev/null 2>&1; then
    for p in xdg-desktop-portal.service xdg-desktop-portal-gtk.service \
             xdg-desktop-portal-wlr.service; do
        systemctl --user restart "$p" 2>/dev/null || true
    done
fi

# ---- keyboard ------------------------------------------------------------------
# Port of the old X11 setup (setxkbmap in .xinitrc/.xprofile): US + Arabic,
# Win+Space switches groups, Caps = Escape, Menu = Win. River otherwise runs a
# plain "us" keymap — GNOME's input sources do NOT apply to this session.
riverctl keyboard-layout -options grp:win_space_toggle,caps:escape,altwin:menu_win us,ara

# Binds whose keysyms differ between the two keyboard groups (letters and a few
# symbols like Slash , .) are pinned to the us layout: river otherwise
# translates a pressed key through the *active* group, so those binds stop
# working the moment Arabic is selected.  `-layout 0` makes the bind match the
# key's layout-0 keysym no matter which group is active (riverctl's man page:
# "this layout is used to translate the key independent of the active layout").
# Function/arrow/XF86 keys are stable in both groups, so they stay unpinned.
map_us() {
    riverctl map -layout 0 "$@"
}

# ---- launcher / terminal -----------------------------------------------------
map_us normal Super P spawn fuzzel
map_us normal Super V spawn "env QT_QPA_PLATFORM=wayland $HOME/.local/bin/copyq --start-server toggle"   # CopyQ clipboard manager
riverctl map normal Super+Shift Return spawn foot # dwm-style terminal

# ---- help / lock --------------------------------------------------------------
# Every lock entry point calls the same wrapper: swaylock needs a tty, and the
# old bare `swaylock -f` paths left a solid screen with no password input.
# Lock on Super+Escape (dwm-ish) and Super+Alt+L (does not steal Super+L,
# which is dwm's master-ratio grow).
riverctl map normal Super Escape spawn "$HOME/.config/river/lock-session.sh"
riverctl map normal Super+Alt L spawn "$HOME/.config/river/lock-session.sh"
# Full keybinding cheat sheet: Super+F1 or Super+? (Super+Shift+Slash).
riverctl map normal Super F1 spawn "$HOME/.config/river/show-shortcuts.sh"
map_us normal Super+Shift Slash spawn "$HOME/.config/river/show-shortcuts.sh"

# ---- dwm core binds ----------------------------------------------------------
map_us normal Super Q close                    # Mod+Shift+Q in dwm
map_us normal Super+Shift E exit

map_us normal Super J focus-view next
map_us normal Super K focus-view previous
map_us normal Super+Shift J swap next          # Mod+Shift+j (push)
map_us normal Super+Shift K swap previous

# dwm's Mod+Return opens a terminal; zoom moved to Super+Z.
riverctl map normal Super Return spawn xdg-terminal-exec   # default terminal (Ptyxis)
map_us normal Super Z zoom
map_us normal Alt I spawn brave-browser
map_us normal Alt Z spawn zcode

# master/stack sizing, exactly like dwm
# master ratio on bare H/L, exactly like dwm (Ctrl+H/L kept as aliases)
map_us normal Super H send-layout-cmd rivertile "main-ratio -0.05"
map_us normal Super L send-layout-cmd rivertile "main-ratio +0.05"
map_us normal Super+Control H send-layout-cmd rivertile "main-ratio -0.05"
map_us normal Super+Control L send-layout-cmd rivertile "main-ratio +0.05"
map_us normal Super+Shift H send-layout-cmd rivertile "main-count -1"
map_us normal Super+Shift L send-layout-cmd rivertile "main-count +1"

# Alt aliases for the comfortable window keys (Alt exists on both keyboard
# sides). Deliberately NOT aliased: Alt+arrows (browser history), Alt+F
# (Firefox menu), Alt+Space (app window menu) - those stay Super-only.
map_us normal Alt J focus-view next
map_us normal Alt K focus-view previous
map_us normal Alt+Shift J swap next
map_us normal Alt+Shift K swap previous
map_us normal Alt Q close
map_us normal Alt Return zoom
map_us normal Alt H send-layout-cmd rivertile "main-ratio -0.05"
map_us normal Alt L send-layout-cmd rivertile "main-ratio +0.05"
map_us normal Alt+Shift H send-layout-cmd rivertile "main-count -1"
map_us normal Alt+Shift L send-layout-cmd rivertile "main-count +1"

# Alt as a *full* window-management modifier (external keyboard has no right
# Super, and AltGr is unused here).  These deliberately avoid the combos apps
# need: Alt+arrows, Alt+F and Alt+Space stay unbound on Alt.
riverctl map normal Alt+Shift Space toggle-float
map_us normal Alt+Shift F toggle-fullscreen
riverctl map normal Alt+Shift Up    send-layout-cmd rivertile "main-location top"
riverctl map normal Alt+Shift Right send-layout-cmd rivertile "main-location right"
riverctl map normal Alt+Shift Down  send-layout-cmd rivertile "main-location bottom"
riverctl map normal Alt+Shift Left  send-layout-cmd rivertile "main-location left"
riverctl map normal Alt Period focus-output next
riverctl map normal Alt Comma focus-output previous
riverctl map normal Alt+Shift Period send-to-output next
riverctl map normal Alt+Shift Comma send-to-output previous
riverctl map normal Alt Escape spawn "$HOME/.config/river/lock-session.sh"
map_us normal Alt P spawn fuzzel
map_us normal Alt V spawn "env QT_QPA_PLATFORM=wayland $HOME/.local/bin/copyq --start-server toggle"
riverctl map normal Alt+Shift Print spawn "$HOME/.config/river/screenshot.sh"
map_us normal Alt+Control+Shift H resize horizontal -100
map_us normal Alt+Control+Shift L resize horizontal 100
map_us normal Alt+Control+Shift J resize vertical 100
map_us normal Alt+Control+Shift K resize vertical -100

# orientation like dwm's mfact side change
riverctl map normal Super Up    send-layout-cmd rivertile "main-location top"
riverctl map normal Super Right send-layout-cmd rivertile "main-location right"
riverctl map normal Super Down  send-layout-cmd rivertile "main-location bottom"
riverctl map normal Super Left  send-layout-cmd rivertile "main-location left"

# ---- tags: dwm tag model on ALT (view = tag set) --------------------------------
# Direct river commands -- no spawned script, no state files. river itself
# tracks the previous tag set (river/command/tags.zig: setFocusedTags,
# toggleFocusedTags and focusPreviousTags all keep output.previous_tags in
# sync), so the Alt+Tab toggle cannot desync from any other path (waybar's
# tag clicks, Alt+Shift+num move-window, ...), and every bind is instant.
for i in $(seq 1 9)
do
    tags=$((1 << ($i - 1)))
    riverctl map normal Alt $i set-focused-tags $tags
    riverctl map normal Alt+Shift $i set-view-tags $tags             # Alt+Shift+num = move window
    riverctl map normal Alt+Control $i toggle-focused-tags $tags
    riverctl map normal Alt+Shift+Control $i toggle-view-tags $tags
done
all_tags=$(((1 << 32) - 1))
riverctl map normal Alt 0 set-focused-tags 511
riverctl map normal Alt+Shift 0 set-view-tags $all_tags
riverctl map normal Alt Tab focus-previous-tags   # current <-> previous tag set (dwm view(0))
# Same tag model on Super, for dwm configs whose MODKEY is Mod4.
for i in $(seq 1 9)
do
    tags=$((1 << ($i - 1)))
    riverctl map normal Super $i set-focused-tags $tags
    riverctl map normal Super+Shift $i set-view-tags $tags
done
riverctl map normal Super 0 set-focused-tags 511
riverctl map normal Super+Shift 0 set-view-tags $all_tags

# ---- float / fullscreen / mouse ------------------------------------------------
riverctl map normal Super+Shift Space toggle-float   # Win+Space = layout switch (see keyboard block)
map_us normal Super F toggle-fullscreen
riverctl map-pointer normal Super BTN_LEFT move-view
riverctl map-pointer normal Super BTN_RIGHT resize-view
riverctl map-pointer normal Super BTN_MIDDLE toggle-float

# ---- resizes -------------------------------------------------------------------
map_us normal Super+Alt+Shift H resize horizontal -100
map_us normal Super+Alt+Shift L resize horizontal 100
map_us normal Super+Alt+Shift J resize vertical 100
map_us normal Super+Alt+Shift K resize vertical -100

map_us normal Super Period focus-output next
map_us normal Super Comma focus-output previous
map_us normal Super+Shift Period send-to-output next
map_us normal Super+Shift Comma send-to-output previous

# ---- volume (PipeWire — pactl is not installed) --------------------------------
for mode in normal locked
do
    riverctl map $mode None XF86AudioRaiseVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+'
    riverctl map $mode None XF86AudioLowerVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-'
    riverctl map $mode None XF86AudioMute        spawn 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'
    riverctl map $mode None XF86MonBrightnessUp   spawn "$HOME/.config/waybar/brightness.sh up"
    riverctl map $mode None XF86MonBrightnessDown spawn "$HOME/.config/waybar/brightness.sh down"
done

# ---- media keys / screenshots / notifications (GNOME conventions) -------------
map_us normal Alt b spawn "killall -USR1 waybar"   # dwm-style bar hide/show (toggles)
riverctl map normal None XF86AudioPlay    spawn "$HOME/.config/river/media-key.sh playpause"
riverctl map normal None XF86AudioPause   spawn "$HOME/.config/river/media-key.sh playpause"
riverctl map normal None XF86AudioNext    spawn "$HOME/.config/river/media-key.sh next"
riverctl map normal None XF86AudioPrev    spawn "$HOME/.config/river/media-key.sh previous"
riverctl map normal None Print            spawn "$HOME/.config/river/screenshot.sh full"   # Print = full screen
riverctl map normal Super+Shift Print     spawn "$HOME/.config/river/screenshot.sh"        # Shift+Print = region

# ---- autostart -----------------------------------------------------------------
# persistent state dir — /tmp is wiped on every boot, which silently killed the bar
# (its log redirect failed -> waybar never started)
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/river-classic"
mkdir -p "$STATE_DIR"
BAR_LOG="$STATE_DIR/waybar.log"

# ---- cross-session cleanup ---------------------------------------------------
# logind has KillUserProcesses=false on this machine: a river child is not
# guaranteed to die with the session. Run the cleanup from the user manager
# (systemd-run --user), outside session-*.scope, so it can stop kanata, the
# gesture grab, CopyQ, the bar/wallpaper/notification daemons and the user
# portals after river exits. Stopping the portals is what lets the next GNOME
# login activate its own backend instead of reusing river's GTK/WLR one.
CLEANUP="$HOME/.config/river/session-cleanup.sh"
if [ -n "$RIVER_PID" ] && [ -x "$CLEANUP" ]; then
    if command -v systemd-run >/dev/null 2>&1; then
        systemd-run --user \
            --unit="river-classic-cleanup-$RIVER_PID" \
            --description="river-classic session cleanup" \
            --collect \
            --setenv=HOME="$HOME" \
            --setenv=PATH="$PATH" \
            "$CLEANUP" "$RIVER_PID" >>"$STATE_DIR/cleanup.log" 2>&1 || true
    fi
    # Always keep a session-scope copy too.  With KillUserProcesses=false the
    # session scope is abandoned instead of killed; this copy survives a user
    # manager stop that would take the systemd-run copy with it.  Running the
    # cleanup twice is idempotent (and releases the grabs either way).
    ( "$CLEANUP" "$RIVER_PID" >>"$STATE_DIR/cleanup.log" 2>&1 & )
fi

# ---- keyboard remapper + touchpad gestures (input-session.sh) -------------------
# kanata (space-hold arrows / caps-hold scroll, configs at 2-setup/linux/kanata.kbd)
# and gestures.py (3-tap back, 4-tap forward, 3/4-finger swipes) both hold a
# global evdev grab. They live in one managed supervisor now because the lock
# screen has to *release* both grabs before GDM takes the seat (Switch User),
# then bring them back when this session is unlocked again — without
# killing the respawn bookkeeping together with the child. input-session.sh
# owns both processes with pidfiles and a pause flag, and `switch-user.sh`
# calls its `pause` verb from the gtklock powerbar button.
INPUT_SESSION="$HOME/.config/river/input-session.sh"
if [ -x "$INPUT_SESSION" ]; then
    if ! "$INPUT_SESSION" start "$RIVER_PID" >>"$STATE_DIR/input-session.log" 2>&1; then
        printf '%s input-session start failed\n' "$(date '+%F %T')" >>"$STATE_DIR/input-session.log"
    fi
else
    printf '%s input-session.sh missing; keyboard/gestures stays off\n' \
        "$(date '+%F %T')" >>"$STATE_DIR/input-session.log"
fi

# ---- clipboard manager (CopyQ 17): Super+V -------------------------------------
# CopyQ reads/writes the Wayland clipboard natively (wlr-data-control).  The
# automatic command in copyq-keep.js re-owns every new selection, so text and
# large images survive the source app closing; copy(item) marks it CopyQ-owned
# so the command cannot loop.  setup.sh also applies the window/paste settings.
# Use the 17.x AppImage wrapper: Ubuntu's 13.0.0 crashes restoring large images.
if [ -x "$HOME/.local/bin/copyq" ] && [ -x "$HOME/.config/river/copyq-setup.sh" ]; then
    QT_QPA_PLATFORM=wayland "$HOME/.config/river/copyq-setup.sh" >>"$STATE_DIR/copyq.log" 2>&1 &
fi

# status bar — up to 3 tries, and every attempt must actually ATTACH to an output
# (a bar that starts while the outputs are still coming up stays invisible)
( for i in 1 2 3 ; do
      before=$(wc -l < "$BAR_LOG" 2>/dev/null || echo 0)
      waybar -c "$HOME/.config/waybar/config.jsonc" >>"$BAR_LOG" 2>&1 &
      wp=$!
      attached=0
      for t in $(seq 1 25) ; do
          sleep 1
          if tail -n +$((before + 1)) "$BAR_LOG" 2>/dev/null | grep -q "Bar configured"; then
              attached=1
              break
          fi
          kill -0 "$wp" 2>/dev/null || break      # waybar died on its own
      done
      [ "$attached" = 1 ] && break
      kill "$wp" 2>/dev/null
      sleep 2
  done ) &
# notifications (unchanged dunstrc — dunst is Wayland-native)
dunst &
# wallpaper — first match wins: $RIVER_WALLPAPER → installed → repo → legacy dwm bundle
WALLPAPER="${RIVER_WALLPAPER:-}"
[ -n "$WALLPAPER" ] || WALLPAPER="$HOME/.local/share/wallpapers/river-classic.jpg"
[ -f "$WALLPAPER" ] || WALLPAPER="$HOME/Github/KnowledgeNuggets/2-setup/linux/river-classic/assets/wallpaper.jpg"
[ -f "$WALLPAPER" ] || WALLPAPER="/home/zaki/dwm-setup - after fix/dwm-setup/wallpapers/anna-wangler-_GqwoiT7QY8-unsplash.jpg"
[ -f "$WALLPAPER" ] && swaybg -i "$WALLPAPER" -m fill &

# tray applets: intentionally not spawned — the bar's network/bluetooth modules are the single
# control surfaces (best practice: no duplicate concern). Uncomment if you ever want tray icons
# command -v nm-applet      >/dev/null 2>&1 && nm-applet      &
# command -v blueman-applet >/dev/null 2>&1 && blueman-applet &

# ---- touchpad (GNOME parity) ---------------------------------------------------
# river applies libinput defaults, which differ from the GNOME session the user
# is used to: tap-to-click off (so right click needs a hard press) and natural
# scroll off. Configure the touchpad only — external mice keep their wheel
# direction. The glob is limited to first/last characters by river.
riverctl input '*Touchpad' tap enabled
riverctl input '*Touchpad' tap-button-map left-right-middle   # 2-finger tap = right
riverctl input '*Touchpad' click-method clickfinger           # physical: 2 fingers = right
riverctl input '*Touchpad' natural-scroll enabled
# Disable-while-typing is OFF: with kanata's virtual keyboard ahead of the
# touchpad clone it occasionally left the pad completely unresponsive (pointer
# frozen, taps/scroll dead) even with no key held. Re-enable this line if you
# prefer libinput's typing suppression.
riverctl input '*Touchpad' disable-while-typing disabled
riverctl input '*Touchpad' drag enabled
# pointer speed: libinput's speed range is -1.0..1.0 (0.0 = default). The user
# settled on 0.2; touchpad only, so an external mouse keeps its own speed.
riverctl input '*Touchpad' pointer-accel 0.2
# scroll speed: the factor multiplies the scroll delta (1.0 = stock, 0.5 = half,
# 3 = 3x faster). Touchpad only — a wheel mouse keeps its own rate. Live tuning
# without a relogin: ~/.config/river/scroll-speed.sh <factor>
riverctl input '*Touchpad' scroll-factor 0.3

# ---- multi-finger touchpad gestures --------------------------------------------
# Owned by input-session.sh above (kanata block). Its managed supervisor band
# and pause state mean the lock screen can stop and restart the daemon for
# user switching without leaving a stuck respawn loop behind. ↓ for the
# actual mapping, see config/river/SHORTCUTS.md / docs in the README.

# ---- graphical-session env for the user manager --------------------------------
# river does not start graphical-session.target, so the user manager needs the
# display environment imported explicitly — otherwise (WantedBy=
# graphical-session.target) units would start environment-blind.
systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null || true

# ---- defaults ------------------------------------------------------------------
riverctl set-repeat 50 300
riverctl default-layout rivertile

# Borders/gaps: no gap to the screen edge, a visible 2 px focused border, and
# 12 px between tiled views (rivertile insets each view by view-padding).
riverctl border-color-focused 0xffd700
riverctl border-color-unfocused 0x3b4252
riverctl border-color-urgent 0xff5555
riverctl border-width 2
rivertile -main-count 1 -outer-padding 0 -view-padding 6 &   # 1 master + stack
# A single visible view fills the output with no gaps (patched rivertile:
# padding 0 when view_count == 1) and no border; with 2+ views the watcher
# restores the 2 px border. It reads river's status protocol
# (view_tags/focused_tags) and calls riverctl.
VIEW_WATCHER="$HOME/.config/river/view-watcher.sh"
if [ -x "$VIEW_WATCHER" ]; then
    "$VIEW_WATCHER" >>"$STATE_DIR/view-watcher.log" 2>&1 &
fi
