#!/bin/sh
# river-classic init — zaki (Ubuntu 26.04, Oct 2026)
# Deviced after /home/zaki/dwm-setup - after fix (dwm 6.5 muscle memory).
# Everything is runtime-configurable: edit & rerun — no recompiling needed.

# GDM does NOT source ~/.profile — make our ~/.local/bin tools visible!
export PATH="$HOME/.local/bin:$PATH"

# river runs this file through `sh -c`; the shell's parent is the compositor.
# gestures.py uses it to stop (and release the touchpad grab) when river exits.
RIVER_PID=$PPID

# publish session env to dbus + user systemd, so dbus-activated services (portals!)
# don't die of activation timeouts under non-GNOME compositors (GNOME does this for
# you; river-classic doesn't!)
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null

# ---- keyboard ------------------------------------------------------------------
# Port of the old X11 setup (setxkbmap in .xinitrc/.xprofile): US + Arabic,
# Win+Space switches groups, Caps = Escape, Menu = Win. River otherwise runs a
# plain "us" keymap — GNOME's input sources do NOT apply to this session.
riverctl keyboard-layout -options grp:win_space_toggle,caps:escape,altwin:menu_win us,ara

# ---- launcher / terminal -----------------------------------------------------
riverctl map normal Super P spawn fuzzel
riverctl map normal Super+Shift Return spawn foot

# ---- dwm core binds ----------------------------------------------------------
riverctl map normal Super Q close                    # Mod+Shift+Q in dwm
riverctl map normal Super+Shift E exit

riverctl map normal Super J focus-view next
riverctl map normal Super K focus-view previous
riverctl map normal Super+Shift J swap next          # Mod+Shift+j (push)
riverctl map normal Super+Shift K swap previous

riverctl map normal Super Return zoom                # dwm Mod+Return = zoom

# master/stack sizing, exactly like dwm
riverctl map normal Super H send-layout-cmd rivertile "main-ratio -0.05"
riverctl map normal Super L send-layout-cmd rivertile "main-ratio +0.05"
riverctl map normal Super+Shift H send-layout-cmd rivertile "main-count -1"
riverctl map normal Super+Shift L send-layout-cmd rivertile "main-count +1"

# orientation like dwm's mfact side change
riverctl map normal Super Up    send-layout-cmd rivertile "main-location top"
riverctl map normal Super Right send-layout-cmd rivertile "main-location right"
riverctl map normal Super Down  send-layout-cmd rivertile "main-location bottom"
riverctl map normal Super Left  send-layout-cmd rivertile "main-location left"

# ---- tags: dwm tag model on ALT (view = tag set) --------------------------------
# Alt+num goes through tag-switch.sh so the previous tag set is remembered;
# Alt+Tab then flips between the two, exactly like dwm's view(0) (tagset[2]).
for i in $(seq 1 9)
do
    tags=$((1 << ($i - 1)))
    riverctl map normal Alt $i spawn "$HOME/.config/river/tag-switch.sh set $i"
    riverctl map normal Alt+Shift $i set-view-tags $tags             # Alt+Shift+num = move window
    riverctl map normal Alt+Control $i spawn "$HOME/.config/river/tag-switch.sh toggle $i"
    riverctl map normal Alt+Shift+Control $i toggle-view-tags $tags
done
all_tags=$(((1 << 32) - 1))
riverctl map normal Alt 0 spawn "$HOME/.config/river/tag-switch.sh all"
riverctl map normal Alt+Shift 0 set-view-tags $all_tags
riverctl map normal Alt Tab spawn "$HOME/.config/river/tag-switch.sh back"   # current <-> previous tag

# ---- float / fullscreen / mouse ------------------------------------------------
riverctl map normal Super+Shift Space toggle-float   # Win+Space = layout switch (see keyboard block)
riverctl map normal Super F toggle-fullscreen
riverctl map-pointer normal Super BTN_LEFT move-view
riverctl map-pointer normal Super BTN_RIGHT resize-view
riverctl map-pointer normal Super BTN_MIDDLE toggle-float

# ---- resizes -------------------------------------------------------------------
riverctl map normal Super+Alt+Shift H resize horizontal -100
riverctl map normal Super+Alt+Shift L resize horizontal 100
riverctl map normal Super+Alt+Shift J resize vertical 100
riverctl map normal Super+Alt+Shift K resize vertical -100

riverctl map normal Super Period focus-output next
riverctl map normal Super Comma focus-output previous
riverctl map normal Super+Shift Period send-to-output next
riverctl map normal Super+Shift Comma send-to-output previous

# ---- volume (PipeWire — pactl is not installed) --------------------------------
for mode in normal locked
do
    riverctl map $mode None XF86AudioRaiseVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+'
    riverctl map $mode None XF86AudioLowerVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-'
    riverctl map $mode None XF86AudioMute        spawn 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'
    riverctl map $mode None XF86MonBrightnessUp   spawn "$HOME/.config/waybar/brightness.sh up"
    riverctl map $mode None XF86MonBrightnessDown spawn "$HOME/.config/waybar/brightness.sh down"
done

# ---- media keys / screenshots / notifications (GNOME conventions) -------------
riverctl map normal Alt b spawn "killall -USR1 waybar"   # dwm-style bar hide/show (toggles)
riverctl map normal None XF86AudioPlay    spawn "$HOME/.config/river/media-key.sh playpause"
riverctl map normal None XF86AudioPause   spawn "$HOME/.config/river/media-key.sh playpause"
riverctl map normal None XF86AudioNext    spawn "$HOME/.config/river/media-key.sh next"
riverctl map normal None XF86AudioPrev    spawn "$HOME/.config/river/media-key.sh previous"
riverctl map normal None Print            spawn "$HOME/.config/river/screenshot.sh full"   # Print = full screen
riverctl map normal Super+Shift Print     spawn "$HOME/.config/river/screenshot.sh"        # Shift+Print = region

# ---- autostart -----------------------------------------------------------------
# persistent state dir — /tmp is wiped on every boot, which silently killed the bar
# (its log redirect failed -> waybar never started)
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/river-classic"
mkdir -p "$STATE_DIR"
BAR_LOG="$STATE_DIR/waybar.log"

# tag history: river always starts on tag 1, so reset the two-slot state
printf '1\n' > "$STATE_DIR/tags-current"
rm -f "$STATE_DIR/tags-last"

# status bar — up to 3 tries, and every attempt must actually ATTACH to an output
# (a bar that starts while the outputs are still coming up stays invisible)
( for i in 1 2 3 ; do
      before=$(wc -l < "$BAR_LOG" 2>/dev/null || echo 0)
      waybar -c "$HOME/.config/waybar/config.jsonc" >>"$BAR_LOG" 2>&1 &
      wp=$!
      attached=0
      for t in $(seq 1 25) ; do
          sleep 1
          if tail -n +$((before + 1)) "$BAR_LOG" 2>/dev/null | grep -q "Bar configured"; then
              attached=1
              break
          fi
          kill -0 "$wp" 2>/dev/null || break      # waybar died on its own
      done
      [ "$attached" = 1 ] && break
      kill "$wp" 2>/dev/null
      sleep 2
  done ) &
# notifications (unchanged dunstrc — dunst is Wayland-native)
dunst &
# wallpaper — first match wins: $RIVER_WALLPAPER → installed → repo → legacy dwm bundle
WALLPAPER="${RIVER_WALLPAPER:-}"
[ -n "$WALLPAPER" ] || WALLPAPER="$HOME/.local/share/wallpapers/river-classic.jpg"
[ -f "$WALLPAPER" ] || WALLPAPER="$HOME/Github/KnowledgeNuggets/2-setup/linux/river-classic/assets/wallpaper.jpg"
[ -f "$WALLPAPER" ] || WALLPAPER="/home/zaki/dwm-setup - after fix/dwm-setup/wallpapers/anna-wangler-_GqwoiT7QY8-unsplash.jpg"
[ -f "$WALLPAPER" ] && swaybg -i "$WALLPAPER" -m fill &

# tray applets: intentionally not spawned — the bar's network/bluetooth modules are the single
# control surfaces (best practice: no duplicate concern). Uncomment if you ever want tray icons
# command -v nm-applet      >/dev/null 2>&1 && nm-applet      &
# command -v blueman-applet >/dev/null 2>&1 && blueman-applet &

# ---- touchpad (GNOME parity) ---------------------------------------------------
# river applies libinput defaults, which differ from the GNOME session the user
# is used to: tap-to-click off (so right click needs a hard press) and natural
# scroll off. Configure the touchpad only — external mice keep their wheel
# direction. The glob is limited to first/last characters by river.
riverctl input '*Touchpad' tap enabled
riverctl input '*Touchpad' tap-button-map left-right-middle   # 2-finger tap = right
riverctl input '*Touchpad' click-method clickfinger           # physical: 2 fingers = right
riverctl input '*Touchpad' natural-scroll enabled
riverctl input '*Touchpad' disable-while-typing enabled
riverctl input '*Touchpad' drag enabled
# pointer speed: libinput's speed range is -1.0..1.0 (0.0 = default). The user
# settled on 0.2; touchpad only, so an external mouse keeps its own speed.
riverctl input '*Touchpad' pointer-accel 0.2
# scroll speed: the factor multiplies the scroll delta (1.0 = stock, 0.5 = half,
# 3 = 3x faster). Touchpad only — a wheel mouse keeps its own rate. Live tuning
# without a relogin: ~/.config/river/scroll-speed.sh <factor>
riverctl input '*Touchpad' scroll-factor 0.3

# ---- multi-finger touchpad gestures --------------------------------------------
# 3-finger tap = back, 4-finger tap = forward, 3-finger swipe up/down = volume.
# The daemon mirrors the pad through a non-clickpad uinput clone, which lets it
# map 1-finger press = left and 2/3-finger press = right (libinput's clickfinger
# has 3 fingers hard-coded to middle and river cannot remap it). The physical
# pad is EVIOCGRABbed only after river adopts the clone; on any exit the grab is
# released by the kernel, so stock clickfinger behaviour always comes back.
# Needs udev/70-river-classic-input.rules (see README) or it exits with code 3.
GESTURES_LOG="$STATE_DIR/gestures.log"
( while :; do
      "$HOME/.config/river/gestures.py" --parent "$RIVER_PID"
      rc=$?
      if [ "$rc" -eq 3 ]; then
          exit 0                       # missing permission/uinput -> no point looping
      elif [ "$rc" -eq 4 ]; then
          sleep 5                      # no touchpad (yet) -> wait for it
      else
          sleep 2
      fi
  done ) >>"$GESTURES_LOG" 2>&1 &

# ---- defaults ------------------------------------------------------------------
riverctl set-repeat 50 300
riverctl default-layout rivertile
rivertile -main-count 1 &   # 1 master + stack (dwm default; '-view-count' does NOT exist in v0.3.17)
