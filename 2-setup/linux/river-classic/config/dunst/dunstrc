# ~/.config/dunst/dunstrc — ported from the dwm bundle (Oct 2026)
# Managed by 2-setup/linux/river-classic/restore.sh
# The old `transparency` key was dropped: dunst >= 1.7 removed it.

[global]
    font = "Noto Sans 14"
    format = "[ <b>%s</b> ]\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    horizontal_padding = 20
    separator_height = 2
    word_wrap = yes
    frame_width = 3
    frame_color = "#FFD700"  # gold border (from the dwm setup)
    idle_threshold = 300
    monitor = 0
    follow = mouse

[urgency_low]
    background = "#FFFFFF"
    foreground = "#000000"
    timeout = 5

[urgency_normal]
    background = "#FFFFFF"
    foreground = "#000000"
    timeout = 10

[urgency_critical]
    background = "#FFFFFF"
    foreground = "#BF616A"
    timeout = 0  # never expire
