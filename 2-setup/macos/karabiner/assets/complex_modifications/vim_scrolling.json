{
  "title": "Vim-style scrolling with Caps Lock layer",
  "rules": [
    {
      "description": "Hold Caps Lock + h/j/k/l/u/d/s/e/c/f/w/gg/G for scrolling",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            {
              "set_variable": {
                "name": "vim_scroll_mode",
                "value": 1
              }
            }
          ],
          "to_after_key_up": [
            {
              "set_variable": {
                "name": "vim_scroll_mode",
                "value": 0
              }
            },
            {
              "set_variable": {
                "name": "vim_g_pending",
                "value": 0
              }
            }
          ],
          "to_if_alone": [{ "key_code": "escape" }]
        },
        {
          "type": "basic",
          "conditions": [{ "name": "vim_scroll_mode", "type": "variable_if", "value": 1 }],
          "from": { "key_code": "j", "modifiers": { "optional": ["any"] } },
          "to": [{ "mouse_key": { "vertical_wheel": -64 } }]
        },
        {
          "type": "basic",
          "conditions": [{ "name": "vim_scroll_mode", "type": "variable_if", "value": 1 }],
          "from": { "key_code": "k", "modifiers": { "optional": ["any"] } },
          "to": [{ "mouse_key": { "vertical_wheel": 64 } }]
        },
        {
          "type": "basic",
          "conditions": [{ "name": "vim_scroll_mode", "type": "variable_if", "value": 1 }],
          "from": { "key_code": "h", "modifiers": { "optional": ["any"] } },
          "to": [{ "mouse_key": { "horizontal_wheel": 64 } }]
        },
        {
          "type": "basic",
          "conditions": [{ "name": "vim_scroll_mode", "type": "variable_if", "value": 1 }],
          "from": { "key_code": "l", "modifiers": { "optional": ["any"] } },
          "to": [{ "mouse_key": { "horizontal_wheel": -64 } }]
        },
        {
          "type": "basic",
          "conditions": [{ "name": "vim_scroll_mode", "type": "variable_if", "value": 1 }],
          "from": { "key_code": "d", "modifiers": { "optional": ["any"] } },
          "to": [{ "mouse_key": { "vertical_wheel": -64 } }]
        },
        {
          "type": "basic",
          "conditions": [{ "name": "vim_scroll_mode", "type": "variable_if", "value": 1 }],
          "from": { "key_code": "e", "modifiers": { "optional": ["any"] } },
          "to": [{ "mouse_key": { "vertical_wheel": 64 } }]
        },
        {
          "type": "basic",
          "conditions": [{ "name": "vim_scroll_mode", "type": "variable_if", "value": 1 }],
          "from": { "key_code": "s", "modifiers": { "optional": ["any"] } },
          "to": [{ "mouse_key": { "vertical_wheel": 192 } }]
        },
        {
          "type": "basic",
          "conditions": [{ "name": "vim_scroll_mode", "type": "variable_if", "value": 1 }],
          "from": { "key_code": "c", "modifiers": { "optional": ["any"] } },
          "to": [{ "mouse_key": { "vertical_wheel": -192 } }]
        },
        {
          "type": "basic",
          "conditions": [{ "name": "vim_scroll_mode", "type": "variable_if", "value": 1 }],
          "from": { "key_code": "f", "modifiers": { "optional": ["any"] } },
          "to": [{ "mouse_key": { "horizontal_wheel": -64 } }]
        },
        {
          "type": "basic",
          "conditions": [{ "name": "vim_scroll_mode", "type": "variable_if", "value": 1 }],
          "from": { "key_code": "w", "modifiers": { "optional": ["any"] } },
          "to": [{ "mouse_key": { "horizontal_wheel": 64 } }]
        },
        {
          "type": "basic",
          "conditions": [{ "name": "vim_scroll_mode", "type": "variable_if", "value": 1 }],
          "from": { "key_code": "u", "modifiers": { "optional": ["any"] } },
          "to": [{ "mouse_key": { "vertical_wheel": 192 } }]
        },
        {
          "type": "basic",
          "conditions": [{ "name": "vim_scroll_mode", "type": "variable_if", "value": 1 }],
          "from": { "key_code": "g", "modifiers": { "mandatory": ["shift"], "optional": ["any"] } },
          "to": [
            { "set_variable": { "name": "vim_g_pending", "value": 0 } },
            { "key_code": "down_arrow", "modifiers": ["left_command"] }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            { "name": "vim_scroll_mode", "type": "variable_if", "value": 1 },
            { "name": "vim_g_pending", "type": "variable_if", "value": 1 }
          ],
          "from": { "key_code": "g", "modifiers": { "optional": ["any"] } },
          "to": [
            { "set_variable": { "name": "vim_g_pending", "value": 0 } },
            { "key_code": "up_arrow", "modifiers": ["left_command"] }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            { "name": "vim_scroll_mode", "type": "variable_if", "value": 1 },
            { "name": "vim_g_pending", "type": "variable_unless", "value": 1 }
          ],
          "from": { "key_code": "g", "modifiers": { "optional": ["any"] } },
          "parameters": { "basic.to_delayed_action_delay_milliseconds": 700 },
          "to": [
            { "set_variable": { "name": "vim_g_pending", "value": 1 } },
            { "key_code": "vk_none" }
          ],
          "to_delayed_action": {
            "to_if_invoked": [{ "set_variable": { "name": "vim_g_pending", "value": 0 } }],
            "to_if_canceled": [{ "set_variable": { "name": "vim_g_pending", "value": 0 } }]
          }
        }
      ]
    }
  ]
}
