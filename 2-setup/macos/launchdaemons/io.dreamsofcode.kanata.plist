<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.dreamsofcode.kanata</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/opt/kanata/bin/kanata</string>
        <string>-c</string>
        <!-- REPLACE <USERNAME> below with your macOS username (plists don't expand ~) -->
        <string>/Users/<USERNAME>/.config/kanata/kanata.kbd</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Library/Logs/Kanata/kanata.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Library/Logs/Kanata/kanata.err.log</string>
</dict>
</plist>
