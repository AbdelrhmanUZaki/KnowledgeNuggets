set -o vi

__fzf_history__() {
  local selected
  selected=$(fc -ln 1 | awk '!seen[$0]++' | tac | \
    fzf --height=40% --layout=reverse --border --prompt='History> ')
  [[ -n "$selected" ]] || return
  if [[ -z ${READLINE_LINE+x} ]]; then
    history -s "$selected"
  else
    READLINE_LINE="$selected"
    READLINE_POINT=${#READLINE_LINE}
  fi
}

# Your own binding fallback (works even without fzf key-bindings file)
bind -m vi-insert -x '"\C-r":__fzf_history__'
bind -m vi-command -x '"\C-r":__fzf_history__'

