# ~/.bashrc

# Enable colorized output for ls
if [ "$(uname)" == "Darwin" ]; then
    alias ls='ls -G'
else
    alias ls='ls --color=auto'
fi

# Human-readable and all files
alias ll='ls -alh'
alias la='ls -A'
alias l='ls -CF'

# Git shortcuts
alias gst='git status --short'
alias gco='git checkout'
alias gcm='git commit -m'
alias gl='git log --oneline --graph --all --decorate'

# Python virtualenv shortcut
alias venv='source venv/bin/activate'

# Faster navigation
alias ..='cd ..'
alias ...='cd ../..'

# Enable colored grep
alias grep='grep --color=auto'

# Function to show current Git branch
parse_git_branch() {
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    if [ -n "$branch" ]; then
        echo "($branch)"
    fi
}

# Enhanced PS1
export PS1="\[\033[1;34m\]\u\[\033[0m\]@\[\033[1;33m\]\h\[\033[0m\]:\[\033[1;36m\]\w\[\033[0m\] \[\033[1;32m\]\$(parse_git_branch)\[\033[0m\] \$ "

# Functions

# Create and enter a directory
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Quick cleanup of all .pyc files
cleanpyc() {
    find . -name "*.pyc" -exec rm -f {} \;
}

# Reload bashrc easily
reload() {
    source ~/.bashrc
    echo "Bashrc reloaded!"
}

