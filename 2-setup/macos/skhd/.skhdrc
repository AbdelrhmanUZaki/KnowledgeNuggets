# Focus windows (vim-style)
# test-sync-marker
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# Move windows
alt + shift - h : yabai -m window --warp west
alt + shift - j : yabai -m window --warp south
alt + shift - k : yabai -m window --warp north
alt + shift - l : yabai -m window --warp east

# Displays (focus)
alt - u : yabai -m display --focus west
alt - o : yabai -m display --focus east

# Move window to display and follow focus
alt + shift - u : yabai -m window --display west; yabai -m display --focus west
alt + shift - o : yabai -m window --display east; yabai -m display --focus east

# App focus/launch (home-row friendly)
alt - a : ~/.config/yabai/focus-or-open-app.sh "Brave Browser"
alt - w : ~/.config/yabai/focus-or-open-app.sh "Warp"
alt - n : ~/.config/yabai/focus-or-open-app.sh "Obsidian"
alt - t : ~/.config/yabai/focus-or-open-app.sh "Telegram"
alt - i : ~/.config/yabai/focus-or-open-app.sh "‎WhatsApp"
alt - o : ~/.config/yabai/focus-or-open-app.sh "OBS"
alt - v : ~/.config/yabai/focus-or-open-app.sh "Code"
alt - g : ~/.config/yabai/focus-or-open-app.sh "GitHub Desktop"
alt - y : ~/.config/yabai/focus-or-open-app.sh "Antigravity"
alt - m : ~/.config/yabai/focus-or-open-app.sh "Microsoft Teams"
alt - e : ~/.config/yabai/focus-or-open-app.sh "Microsoft Outlook"

# Resize windows
alt + ctrl - h : yabai -m window --resize left:-60:0; yabai -m window --resize right:-60:0
alt + ctrl - j : yabai -m window --resize bottom:0:60; yabai -m window --resize top:0:60
alt + ctrl - k : yabai -m window --resize bottom:0:-60; yabai -m window --resize top:0:-60
alt + ctrl - l : yabai -m window --resize right:60:0; yabai -m window --resize left:60:0

# Layout helpers
alt - f : yabai -m window --toggle zoom-fullscreen
alt - p : yabai -m window --toggle zoom-parent
alt - space : yabai -m window --toggle float
alt + ctrl - 0 : yabai -m space --balance

# Spaces (focus)
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9
alt - 0 : yabai -m space --focus 10

# Move window to spaces
alt + shift - 1 : yabai -m window --space 1; yabai -m space --focus 1
alt + shift - 2 : yabai -m window --space 2; yabai -m space --focus 2
alt + shift - 3 : yabai -m window --space 3; yabai -m space --focus 3
alt + shift - 4 : yabai -m window --space 4; yabai -m space --focus 4
alt + shift - 5 : yabai -m window --space 5; yabai -m space --focus 5
alt + shift - 6 : yabai -m window --space 6; yabai -m space --focus 6
alt + shift - 7 : yabai -m window --space 7; yabai -m space --focus 7
alt + shift - 8 : yabai -m window --space 8; yabai -m space --focus 8
alt + shift - 9 : yabai -m window --space 9; yabai -m space --focus 9
alt + shift - 0 : yabai -m window --space 10; yabai -m space --focus 10
