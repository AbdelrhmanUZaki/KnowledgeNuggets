{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-wakatime",
    "context-mode",
    "@mohak34/opencode-notifier@latest",
    "opencode-enforce-context-mode"
  ],
  "mcp": {
    "context-mode": {
      "type": "local",
      "command": [
        "context-mode"
      ]
    },
    "token-savior": {
      "type": "local",
      "command": [
        "token-savior"
      ],
      "environment": {
        "WORKSPACE_ROOTS": "$HOME/StudioProjects/SaveZone",
        "TOKEN_SAVIOR_CLIENT": "opencode"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking@latest"
      ]
    }
  },
  "skills": {
    "enable": [
      "caveman",
      "systematic-debugging",
      "brainstorming",
      "verification-before-completion"
    ]
  },
  "permission": {
    "bash": "ask",
    "read": {
      "~/.config/opencode/get-shit-done/*": "allow"
    },
    "external_directory": {
      "~/.config/opencode/get-shit-done/*": "allow"
    }
  },
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      }
    },
    "tokenrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenRouter",
      "options": {
        "baseURL": "https://api.tokenrouter.com/v1"
      },
      "models": {
        "MiniMax-M3": {
          "name": "MiniMax M3",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  }
}
